{
  "name": "agora-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform ios --output-dir dist",
    "smoke": "tsc src/api.ts --outDir build --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs"
  },
  "dependencies": {
    "expo": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.0"
  }
}
