<clickhouse>
  <!-- Bound background pools and caches for a local 8 GB Docker Desktop. -->
  <max_server_memory_usage>1200000000</max_server_memory_usage>
  <background_schedule_pool_size>8</background_schedule_pool_size>
  <background_pool_size>16</background_pool_size>
  <mark_cache_size>134217728</mark_cache_size>
  <uncompressed_cache_size>67108864</uncompressed_cache_size>
  <total_memory_profiler_step>0</total_memory_profiler_step>
  <!-- Disable internal ClickHouse system.*_log tables so background merges do not starve Docker CPU/IO. -->
  <asynchronous_insert_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <background_schedule_pool_log remove="1"/>
  <error_log remove="1"/>
  <instrumentation_trace_log remove="1"/>
  <metric_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <part_log remove="1"/>
  <processors_profile_log remove="1"/>
  <query_log remove="1"/>
  <query_metric_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_views_log remove="1"/>
  <session_log remove="1"/>
  <text_log remove="1"/>
  <trace_log remove="1"/>
  <zookeeper_log remove="1"/>
</clickhouse>
