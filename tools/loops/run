#!/usr/bin/env python3
# Spec: knowledge/operations/loops.md
"""Run one explicitly bounded job; terminate its ordinary process descendants on timeout."""
import argparse
from pathlib import Path
import subprocess
import signal
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'architecture'))
from process import run

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--timeout', type=int, required=True)
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ['--'] else args.command
if args.timeout <= 0 or not command:
    parser.error('a positive timeout and command are required')


def interrupted(signum, frame):
    raise KeyboardInterrupt


signal.signal(signal.SIGTERM, interrupted)
try:
    run(command, timeout=args.timeout)
except subprocess.TimeoutExpired:
    parser.exit(124, 'Æion Factory loop deadline reached; child processes terminated.\n')
except KeyboardInterrupt:
    parser.exit(130, 'Æion Factory loop interrupted; child processes terminated.\n')
except (OSError, subprocess.CalledProcessError) as error:
    parser.exit(1, f'Æion Factory loop failed: {error}\n')
