#!/usr/bin/env bash
# Rebuilds the guide, CRAFTED principles and seven chapters as one file.
# Spec: knowledge/operations/build-and-test.md
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../../efficiency"
{
    echo "<!-- Generated by tools/efficiency/bundle from the chapter files; edit those, not this. -->"
    for f in 00-EFFICIENCY.md CRAFTED.md 1-quarks.md 2-atoms.md 3-molecules.md 4-cells.md 5-organisms.md 6-constellations.md 7-galaxy.md; do
        echo
        # Links to other chapters and to the credits become text: this file travels alone.
        sed -E 's#\[([^]]+)\]\(([0-9])-[a-z]+\.md\)#\1 (phase \2, below)#g; s#\[([^]]+)\]\(\.\./CREDITS\.md\)#\1 (at the end of this file)#g; s#\[CRAFTED\]\(CRAFTED\.md\)#CRAFTED (principles below)#g' "$f"
        echo
        echo "---"
    done
    echo
    sed 's#\[license notice\](docs/licenses/superpowers-MIT.txt)#license notice reproduced below#g' ../CREDITS.md
    echo
    echo "## Superpowers license notice"
    echo
    cat ../docs/licenses/superpowers-MIT.txt
} > efficiency-bundle.md
echo "efficiency-bundle.md: $(wc -l < efficiency-bundle.md) lines"
