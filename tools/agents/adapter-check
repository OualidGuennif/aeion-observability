#!/usr/bin/env python3
# Spec: knowledge/operations/agent-compatibility.md
"""Compare a repository's harness connectors with the factory copy this script ships in.

A project vendors the factory's adapters by copying them, so a hand edit to one copy is
invisible until the day that harness silently stops loading it. This check names every
copy that differs, and every native config that points at a file which is not there.

    tools/agents/adapter-check                 # the repository this script lives in
    tools/agents/adapter-check --root ../app   # a project that adopted the factory
"""
import argparse
import json
import re
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[2]

sys.path.insert(0, str(Path(__file__).resolve().parent))
from connectors import CONTRACT as VENDORED, WIRING, executable, linked  # noqa: E402
from refs import Refused, ref_bytes, ref_exists, ref_mode, require_repository  # noqa: E402

# Every harness-facing file the factory ships: a copy must stay byte-identical, because an
# adapter's failure is silent and its body is not something a project edits.
# Native configs a project may merge with its own settings, so they are not compared, but a
# command in them still has to name a file that exists.
# A command in these files names its script as a path from the project root, sometimes after a
# shell expansion of that root, so the path itself may follow any character.
SCRIPT = re.compile(r"((?:tools|\.claude|\.dsh|\.pi|\.opencode|\.codex|\.devin|\.factory)/[\w./-]+\.(?:py|js|sh))")
# The dsh patch names its plugin modules relative to the .dsh folder that holds it.
MODULE = re.compile(r"(?<![\w./-])(\./[\w./-]+\.js)")


def factory_version(repo, ref=None):
    """The version of the side this run treats as canonical: the working tree, or one reference."""
    try:
        if ref is not None:
            return ref_bytes(repo, ref, "VERSION").decode("utf-8").strip()
        return (repo / "VERSION").read_text(encoding="utf-8").strip()
    except (OSError, Refused):
        return "unknown"


def compare(root, read=None, expected_mode=None):
    """(drifted, missing, clean, linked, modes) over every vendored file, by exact bytes and mode."""
    read = read or (lambda relative: (FACTORY / relative).read_bytes())
    expected_mode = expected_mode or (lambda relative: (FACTORY / relative).stat().st_mode)
    drifted, missing, clean, links, modes = [], [], [], [], []
    for relative in VENDORED:
        link = linked(root, relative)
        if link:
            # Reading through the link would hide that the project owns no regular file there.
            links.append((relative, link))
            continue
        found = root / relative
        if not found.is_file():
            missing.append(relative)
            continue
        try:
            expected = read(relative)
        except Refused:
            # An older release legitimately lacks a file added later; the working tree is the reference
            # and always carries the whole list.
            continue
        actual = found.read_bytes()
        if expected != actual:
            drifted.append((relative, len(expected), len(actual)))
            continue
        clean.append(relative)
        try:
            wanted = expected_mode(relative)
        except (OSError, Refused):
            wanted = None
        if wanted is not None and executable(wanted) and not executable(found.stat().st_mode):
            modes.append(relative)
    return drifted, missing, clean, links, modes


def references(text, relative):
    """The script paths a config names, as written."""
    pattern = MODULE if relative == ".dsh/factory.patch.yml" else SCRIPT
    return sorted(set(pattern.findall(text)))


# A steered or injected message with no identity, or no role, is persisted as history the harness
# cannot reopen, so the whole session stops loading. Every steer/inject/followup call must carry an id
# and a role in its own literal, not nested below.
STEER = re.compile(r"\.(?:steer|inject|followup)\s*\(\s*\{")
FIELDS = {"id": r"\bid\s*:", "role": r"\brole\s*:"}


def fielded(body, field):
    """Whether an object literal names one top-level field, scanning braces a literal way."""
    pattern = FIELDS[field]
    depth = 0
    index = 0
    while index < len(body):
        character = body[index]
        if character in "{[(":
            depth += 1
        elif character in "}])":
            depth -= 1
        elif depth == 0 and re.match(pattern, body[index:]):
            return True
        index += 1
    return False


def unfielded(text, field):
    """The 1-based lines of every steer/inject/followup call whose object literal lacks the top-level field."""
    lines = []
    for match in STEER.finditer(text):
        opening = text.find("{", match.start())
        depth, index = 0, opening
        while index < len(text):
            if text[index] == "{":
                depth += 1
            elif text[index] == "}":
                depth -= 1
                if depth == 0:
                    break
            index += 1
        if not fielded(text[opening + 1:index], field):
            lines.append(text.count("\n", 0, match.start()) + 1)
    return lines


def unidentified(text):
    """The 1-based lines of every steer/inject/followup call whose object literal has no top-level id."""
    return unfielded(text, "id")


def unroled(text):
    """The 1-based lines of every steer/inject/followup call whose object literal has no top-level role."""
    return unfielded(text, "role")


def wiring(root):
    """(unwired, broken) for every native config that is present."""
    unwired, broken = [], []
    for relative in WIRING:
        config = root / relative
        if not config.is_file():
            continue
        text = config.read_text(encoding="utf-8", errors="replace")
        if relative.endswith(".json"):
            try:
                json.loads(text)
            except json.JSONDecodeError as error:
                broken.append((relative, str(error)))
                continue
        # The dsh patch sits in .dsh and names its modules from there; every other path starts at the root.
        base = root / ".dsh" if relative == ".dsh/factory.patch.yml" else root
        for reference in references(text, relative):
            target = base / (reference[2:] if reference.startswith("./") else reference)
            if not target.is_file():
                unwired.append((relative, reference))
    return unwired, broken


def main():
    parser = argparse.ArgumentParser(
        prog="adapter-check",
        description="Compare a repository's harness connectors with the factory copy this script ships in.",
    )
    parser.add_argument("--root", default=str(FACTORY), help="the repository to check (default: this one)")
    parser.add_argument("--ref", help="compare against this git reference (tag, main, develop, sha), not the working tree")
    parser.add_argument("--repo", default=str(FACTORY), help="the repository holding the reference (default: this checkout)")
    parser.add_argument("--strict", action="store_true", help="also fail when a connector is not vendored")
    parser.add_argument("--self", action="store_true", help="allow the factory to compare with itself")
    parser.add_argument("--verbose", action="store_true", help="list the connectors that are absent")
    arguments = parser.parse_args()

    root = Path(arguments.root).resolve()
    repo = Path(arguments.repo).resolve()
    if not root.is_dir():
        print(f"adapter-check: {root} is not a directory", file=sys.stderr)
        return 2
    # A project that copied this script compares its copies with themselves and always passes: refuse it,
    # so the project's CI runs this script from a pinned factory checkout with --root instead.
    if root == FACTORY and not arguments.self and not arguments.ref:
        print(f"adapter-check: {root} is the copy this script lives in, so every connector would match "
              f"itself; run the factory's copy with --root {root}, or pass --self to check the factory",
              file=sys.stderr)
        return 2

    reference = arguments.ref
    if reference:
        try:
            require_repository(repo)
        except Refused as refusal:
            print(f"adapter-check: {refusal}", file=sys.stderr)
            return 2
        if not ref_exists(repo, reference):
            print(f"adapter-check: no such reference: {reference}", file=sys.stderr)
            return 2
    read = (lambda relative: ref_bytes(repo, reference, relative)) if reference else None
    expected_mode = (lambda relative: ref_mode(repo, reference, relative)) if reference else None

    drifted, missing, clean, linked_paths, mode_issues = compare(root, read, expected_mode)
    unwired, broken = wiring(root)
    unmanaged, unroled_calls = [], []
    for relative in VENDORED:
        if not relative.endswith(".js") or linked(root, relative) or not (root / relative).is_file():
            continue
        text = (root / relative).read_text(encoding="utf-8", errors="replace")
        for line in unidentified(text):
            unmanaged.append((relative, line))
        for line in unroled(text):
            unroled_calls.append((relative, line))

    print(f"adapter-check: factory {factory_version(repo, reference)} at {repo}")
    print(f"               against {root}")
    if reference:
        print(f"               reference {reference}")
    for relative in clean:
        print(f"ok        {relative}")
    for relative, expected, actual in drifted:
        print(f"DRIFT     {relative} — {actual} bytes, factory has {expected}")
    for relative, link in linked_paths:
        print(f"LINKED    {relative} — {link} is a symlink; a connector must be a regular file")
    for relative in mode_issues:
        print(f"MODE      {relative} — not executable; the reference records an executable file")
    if arguments.verbose:
        for relative in missing:
            print(f"missing   {relative}")
    for relative, reference in unwired:
        print(f"UNWIRED   {relative} → {reference} — no such file")
    for relative, error in broken:
        print(f"invalid   {relative} — {error}")
    for relative, line in unmanaged:
        print(f"UNIDENTIFIED {relative} — steer() without an id at line {line}")
    for relative, line in unroled_calls:
        print(f"UNROLED {relative} — steer()/inject()/followup() without a role at line {line}")

    failed = bool(drifted or unwired or broken or unmanaged or unroled_calls or linked_paths or mode_issues)
    if arguments.strict and missing:
        failed = True
    if drifted and reference:
        print(f"\nRepair each drifted copy from the reference, then run the project's tests:")
        for relative, _, _ in drifted:
            print(f"  git show {reference}:{relative} > {root / relative}")
    elif drifted:
        print("\nRepair each drifted copy from the factory, then run the project's tests:")
        for relative, _, _ in drifted:
            print(f"  cp {FACTORY / relative} {root / relative}")
    if mode_issues:
        print("\nRestore the executable bit on each launcher:")
        for relative in mode_issues:
            print(f"  chmod +x {root / relative}")
    if linked_paths:
        print("\nReplace each linked connector with a regular file owned by the project.")
    if arguments.strict and missing:
        print("\nVendored set incomplete; adopt the missing connectors or drop --strict.")

    print(
        f"\n{len(VENDORED)} connectors: {len(clean)} matching, {len(drifted)} drifted, "
        f"{len(missing)} absent, {len(unwired)} unwired, {len(broken)} invalid, "
        f"{len(unmanaged)} unidentified, {len(unroled_calls)} unroled, "
        f"{len(linked_paths)} linked, {len(mode_issues)} mode"
    )
    print("adapter-check: PASS" if not failed else "adapter-check: FAIL")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
