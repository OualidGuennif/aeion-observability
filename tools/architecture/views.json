  {
    "schema_version": 2,
    "diagram_type": "workflow",
    "meta": {
      "title": "Reviewed delivery and mandatory analysis",
      "quality_profile": "showcase",
      "output": "workflow.html"
    },
    "lanes": [
      {
        "id": "delivery",
        "label": "Authorized delivery"
      },
      {
        "id": "analysis",
        "label": "Immutable analysis"
      },
      {
        "id": "failure",
        "label": "Failure and recovery",
        "variant": "exception"
      }
    ],
    "mainPath": [
      "review",
      "merge",
      "snapshot",
      "graph",
      "archify",
      "receipt"
    ],
    "nodes": [
      {
        "id": "review",
        "lane": "delivery",
        "col": 0,
        "type": "security",
        "label": "Review and CI",
        "sublabel": "verified; owner authorized",
        "sources": [
          {
            "path": ".claude/skills/pr-review/SKILL.md",
            "anchor": "# Review a change"
          }
        ]
      },
      {
        "id": "merge",
        "lane": "delivery",
        "col": 1,
        "type": "backend",
        "label": "Merge to main",
        "sublabel": "explicit target SHA",
        "sources": [
          {
            "path": ".github/workflows/architecture-refresh.yml",
            "anchor": "name: Architecture refresh"
          }
        ]
      },
      {
        "id": "snapshot",
        "lane": "analysis",
        "col": 2,
        "type": "backend",
        "label": "Freeze source",
        "sublabel": "clean tracked snapshot",
        "sources": [
          {
            "path": "tools/architecture/refresh",
            "anchor": "manifest, excluded = scope(root, target, config)"
          }
        ]
      },
      {
        "id": "graph",
        "lane": "analysis",
        "col": 3,
        "type": "backend",
        "label": "Graphify",
        "sublabel": "code and Markdown structure",
        "sources": [
          {
            "path": "tools/architecture/graph.py",
            "anchor": "extraction = extract("
          }
        ]
      },
      {
        "id": "archify",
        "lane": "analysis",
        "col": 4,
        "type": "backend",
        "label": "Archify",
        "sublabel": "evidence and browser gates",
        "sources": [
          {
            "path": "tools/architecture/refresh",
            "anchor": "for view in views:"
          }
        ]
      },
      {
        "id": "receipt",
        "lane": "analysis",
        "col": 5,
        "type": "database",
        "label": "Verified artifact",
        "sublabel": "hashes and target SHA",
        "sources": [
          {
            "path": "tools/architecture/refresh",
            "anchor": "os.replace(temporary_receipt, output / \"receipt.json\")"
          }
        ]
      },
      {
        "id": "failed",
        "lane": "failure",
        "col": 4,
        "type": "security",
        "label": "Round incomplete",
        "sublabel": "correct and retry same SHA",
        "sources": [
          {
            "path": "knowledge/operations/architecture-maintenance.md",
            "anchor": "A failed post-merge round blocks closure/release"
          }
        ]
      }
    ],
    "edges": [
      {
        "id": "ready",
        "from": "review",
        "to": "merge",
        "label": "approved"
      },
      {
        "id": "trigger",
        "from": "merge",
        "to": "snapshot",
        "label": "main push"
      },
      {
        "id": "extract",
        "from": "snapshot",
        "to": "graph",
        "label": "allowed corpus"
      },
      {
        "id": "views",
        "from": "graph",
        "to": "archify",
        "label": "reviewed spec and sources"
      },
      {
        "id": "pass",
        "from": "archify",
        "to": "receipt",
        "label": "all gates pass",
        "variant": "emphasis"
      },
      {
        "id": "failure",
        "from": "archify",
        "to": "failed",
        "label": "gate fails",
        "variant": "security",
        "role": "error"
      }
    ],
    "cards": [
      {
        "dot": "cyan",
        "title": "Every main update",
        "items": [
          "Includes docs-only, squash, rebase and multi-commit pushes",
          "One artifact per immutable SHA; no generated-source push"
        ]
      },
      {
        "dot": "rose",
        "title": "Failure boundary",
        "items": [
          "Any extraction, provenance or browser failure refuses PASS",
          "A failed post-merge round blocks completed-work and release claims"
        ]
      }
    ]
  },
  {
    "schema_version": 3,
    "diagram_type": "lifecycle",
    "meta": {
      "title": "Context checkpoints (Claude, Codex, OpenCode, Pi, dsh)",
      "quality_profile": "showcase",
      "output": "lifecycle.html"
    },
    "mainPath": [
      "running",
      "handover",
      "checkpoint",
      "recovering"
    ],
    "states": [
      {
        "id": "running",
        "type": "start",
        "label": "Running",
        "sublabel": "positive native usage below 250k",
        "sources": [
          {
            "path": "tools/context/budget.py",
            "anchor": "WARNING = 250_000"
          }
        ]
      },
      {
        "id": "handover",
        "type": "active",
        "label": "Handover required",
        "sublabel": "closure work only",
        "sources": [
          {
            "path": "tools/context/budget.py",
            "anchor": "state[\"state\"] = \"HANDOVER_REQUIRED\""
          }
        ]
      },
      {
        "id": "checkpoint",
        "type": "decision",
        "label": "Checkpoint verified",
        "sublabel": "docs and source hashes match",
        "sources": [
          {
            "path": "tools/context/budget.py",
            "anchor": "def checkpoint(root, session, base):"
          }
        ]
      },
      {
        "id": "recovering",
        "type": "waiting",
        "label": "Recovering",
        "sublabel": "compact; restore handover",
        "sources": [
          {
            "path": "tools/context/budget.py",
            "anchor": "\"state\": \"RECOVERING\", \"warning_pending\""
          }
        ]
      },
      {
        "id": "stopped",
        "type": "active",
        "label": "Compaction forced",
        "sublabel": "observed 300k: handover and checkpoint only",
        "sources": [
          {
            "path": "tools/context/budget.py",
            "anchor": "if usage >= LIMIT and state[\"state\"] != \"COMPACT_REQUIRED\":"
          }
        ]
      }
    ],
    "transitions": [
      {
        "id": "warn",
        "from": "running",
        "to": "handover",
        "label": "250k observed"
      },
      {
        "id": "verify",
        "from": "handover",
        "to": "checkpoint",
        "label": "checkpoint passes"
      },
      {
        "id": "compact",
        "from": "checkpoint",
        "to": "recovering",
        "label": "compaction"
      },
      {
        "id": "resume",
        "from": "recovering",
        "to": "running",
        "label": "fresh observation"
      },
      {
        "id": "limit",
        "from": "handover",
        "to": "stopped",
        "label": "300k observed",
        "variant": "security"
      },
      {
        "id": "forced-verify",
        "from": "stopped",
        "to": "checkpoint",
        "label": "checkpoint passes"
      }
    ],
    "cards": [
      {
        "dot": "cyan",
        "title": "Before compaction",
        "items": [
          "Create the handover at session start",
          "Validate docs, current task and exact source state"
        ]
      },
      {
        "dot": "rose",
        "title": "Observed boundaries",
        "items": [
          "No qualified pre-request callback is available",
          "Strict launch refuses; this is checkpoint enforcement only"
        ]
      }
    ]
  }
]
