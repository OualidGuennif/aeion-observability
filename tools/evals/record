#!/usr/bin/env python3
# Spec: knowledge/operations/evals.md
"""Append one evaluation record to the JSONL file; --dry-run prints it and writes nothing."""
import argparse
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2]
SLUG = re.compile(r"^[a-z0-9][a-z0-9-]*$")
DEFAULT_FILE = "tools/evals/results.jsonl"


def slug(parser, name, value):
    if not SLUG.fullmatch(value):
        parser.error(f"--{name} must match {SLUG.pattern}")
    return value


def finite(parser, name, value):
    if value is not None and not math.isfinite(value):
        parser.error(f"--{name} must be a finite number")
    return value


def non_negative(parser, name, value):
    if value is not None and value < 0:
        parser.error(f"--{name} must be >= 0")
    return value


def target(value):
    path = Path(value)
    return path if path.is_absolute() else ROOT / path


def factory_version():
    try:
        return (ROOT / "VERSION").read_text(encoding="utf-8").strip()
    except OSError as error:
        print(f"FAIL cannot read VERSION: {error}", file=sys.stderr)
        sys.exit(2)


def build(args):
    fields = {
        "task": args.task,
        "harness": args.harness,
        "success": args.success == "yes",
        "minutes": args.minutes,
        "model": args.model,
        "factory": args.factory,
        "tokens": args.tokens,
        "cost_usd": args.cost_usd,
        "human_interventions": args.human_interventions,
        "rework_commits": args.rework_commits,
        "defects_after_done": args.defects_after_done,
        "notes": args.notes,
    }
    # Omit unknown optional metrics so reporting can distinguish them from measured zero.
    record = {key: value for key, value in fields.items() if value is not None}
    record["recorded_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return record


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task", required=True, help="task folder name under tools/evals/tasks")
    parser.add_argument("--harness", required=True, help="agent harness, for example claude-code")
    parser.add_argument("--success", required=True, choices=("yes", "no"), help="did CHECK.md pass")
    parser.add_argument("--minutes", required=True, type=float, help="wall-clock minutes")
    parser.add_argument("--model")
    parser.add_argument("--factory", help="factory version; defaults to VERSION")
    parser.add_argument("--tokens", type=int)
    parser.add_argument("--cost-usd", type=float)
    parser.add_argument("--human-interventions", type=int)
    parser.add_argument("--rework-commits", type=int)
    parser.add_argument("--defects-after-done", type=int)
    parser.add_argument("--notes")
    parser.add_argument("--file", default=DEFAULT_FILE, help="JSONL file, absolute or from the repository root")
    parser.add_argument("--dry-run", action="store_true", help="print the record and write nothing")
    args = parser.parse_args(argv)

    slug(parser, "task", args.task)
    slug(parser, "harness", args.harness)
    # NaN and inf pass a zero comparison but json.dumps writes them unparseable, so refuse them first.
    for name in ("minutes", "cost_usd"):
        finite(parser, name.replace("_", "-"), getattr(args, name))
    for name in ("minutes", "tokens", "cost_usd", "human_interventions", "rework_commits", "defects_after_done"):
        non_negative(parser, name.replace("_", "-"), getattr(args, name))
    if args.factory is None:
        args.factory = factory_version()

    record = build(args)
    line = json.dumps(record, separators=(",", ":"))
    path = target(args.file)
    if args.dry_run:
        print(line)
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+b") as stream:
        separator = b""
        if stream.tell():
            stream.seek(-1, os.SEEK_END)
            if stream.read(1) != b"\n":
                separator = b"\n"
        stream.write(separator + line.encode("utf-8") + b"\n")
    print(f"{path}: {args.task}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
