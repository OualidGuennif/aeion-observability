# Æion Factory loops on an always-on machine (crontab -e). Times are local. Each job refuses to run
# while LOOPS_ENABLED is not true in env.local. Replace /path/to/repo.
15 6 * * *   cd /path/to/repo && loops/orchestrator.sh outer
30 6 * * *   cd /path/to/repo && loops/orchestrator.sh docs
0 7 * * 1    cd /path/to/repo && loops/orchestrator.sh security
0 8 * * 5    cd /path/to/repo && loops/orchestrator.sh retro
0 9 1 * *    cd /path/to/repo && loops/orchestrator.sh watch
*/30 9-19 * * 1-5 cd /path/to/repo && loops/orchestrator.sh middle
# Optional OpenShell proof auto-refresh (runs every 6 hours; probes only if <1h left or expired):
# 0 */6 * * * cd /path/to/repo && demo/.local/venv/bin/python -c 'import sys; from pathlib import Path; sys.path.insert(0, "demo/app"); import settings; from sandbox import connection; connection()' >/dev/null 2>&1
